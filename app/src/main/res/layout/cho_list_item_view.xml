<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="benVisitInfo"
            type="org.piramalswasthya.cho.model.PatientDisplayWithVisitInfo" />

        <variable
            name="clickListener"
            type="org.piramalswasthya.cho.adapter.CHOCaseRecordItemAdapter.BenClickListener" />

    </data>

    <LinearLayout
        android:id="@+id/itemll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{() -> clickListener.onClickedBen(benVisitInfo)}"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/visit_number_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ben_visit_num"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/visit_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/visit_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ben_visit_date"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/visit_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_flow_completed"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/flowCompleted"
            android:src="@drawable/ic_check_circle_green"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/visit_selected_icon"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/ben_visit_num"
            android:src="@drawable/tick_img"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</layout>